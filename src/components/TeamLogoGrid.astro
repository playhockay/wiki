---
// The 48 team crests, linking to their pages. Kept in conference order so the
// two halves of the league read as two halves.
//
// The logos are static files under `public/team-logos/` rather than inline SVG.
// Inlined, this grid was 1.3 MB of markup on every homepage request; as assets
// they are fetched once and then served from cache (see `public/_headers`).
//
// Only the colour logo is fetched. The resting state is `filter: grayscale(1)`,
// which is what the separate monochrome files were for — they are the same
// geometry with the fills swapped, so downloading them too would double the
// payload for an effect CSS does for free.

interface Team {
	id: string;
	slug: string;
	name: string;
}

