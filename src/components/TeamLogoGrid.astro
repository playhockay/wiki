	{ id: "atl", slug: "atlantis-amonites", name: "Atlantis Amonites" },
];

const CONFERENCES = [
	{ label: "La Conférence du Verglas", teams: VERGLAS },
	{ label: "La Conférence du Givre", teams: GIVRE },
];
---

<div class="not-content logo-grid">
	{
		CONFERENCES.map(({ label, teams }) => (
			<section>
				<h3 class="logo-grid-label">{label}</h3>
				<ul class="logo-grid-row">
					{teams.map((team) => (
						<li>
							<a href={`/teams/${team.slug}/`} title={team.name}>
								<img
									src={`/team-logos/${team.id}.svg`}
									alt={team.name}
									width="32"
									height="32"
									loading="lazy"
									decoding="async"
								/>
							</a>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.logo-grid {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		margin: 1.5rem 0;
	}

	.logo-grid-label {
		margin: 0 0 0.625rem;
		font-family: var(--font-mono, monospace);
		font-size: 0.6875rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	.logo-grid-row {
		display: grid;
		grid-template-columns: repeat(8, 2rem);
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
		justify-content: start;
	}

	@media (min-width: 50rem) {
		.logo-grid-row {
			grid-template-columns: repeat(12, 2rem);
		}
	}

	@media (min-width: 72rem) {
		.logo-grid-row {
			grid-template-columns: repeat(24, 2rem);
		}
	}

	.logo-grid-row a {
		display: block;
		width: 2rem;
		height: 2rem;
	}

	.logo-grid-row img {
		width: 2rem;
		height: 2rem;
		/* Crests are not all square—several viewBoxes are close to 2:1. */
		object-fit: contain;
		/* The resting state the separate monochrome files used to provide. */
		filter: grayscale(1);
		opacity: 0.4;
		transition:
			filter 150ms ease,
			opacity 150ms ease;
	}

	.logo-grid-row a:hover img,
	.logo-grid-row a:focus-visible img {
		filter: grayscale(0);
		opacity: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-grid-row img {
			transition: none;
		}
	}
</style>
