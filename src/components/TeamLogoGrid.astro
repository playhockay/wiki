	{ id: "rim", slug: "rimini-rinklers", name: "Rimini Rinklers" },
	{ id: "jbg", slug: "johannesburg-jaguars", name: "Johannesburg Jaguars" },
	{ id: "mum", slug: "mumbai-monsoons", name: "Mumbai Monsoons" },
